// SPDX-License-Identifier: Apache-2.0
// bessd-side config for the SD-Core testbed (read by bessd via conf/up4.bess ->
// Parser('conf/upf.jsonc'); mounted into the upf-bess container at that path).
// This drives the BESS af_packet datapath on its OWN access/core veths. pfcpiface
// (the `upf` container) connects to this bessd over the network (--bess upf-bess:10514)
// so that upf.isConnected() is true and the SMF association is accepted.
{
    "mode": "af_packet",

    "table_sizes": {
        "pdrLookup": 50000,
        "flowMeasure": 200000,
        "appQERLookup": 200000,
        "sessionQERLookup": 100000,
        "farLookup": 150000
    },

    "log_level": "info",
    "hwcksum": false,
    "gtppsc": false,
    "ddp": false,
    "measure_upf": true,
    "measure_flow": false,

    // veths created by upf/bess-entrypoint.sh inside this container's netns
    "access": { "ifname": "access" },
    "core":   { "ifname": "core" },

    "workers": 1,
    "max_req_retries": 5,
    "resp_timeout": "2s",
    "enable_ntf": false,
    "enable_hbTimer": false,
    "enable_gtpu_path_monitoring": false,

    "qci_qos_config": [
        { "qci": 0, "cbs": 50000, "ebs": 50000, "pbs": 50000, "burst_duration_ms": 10, "priority": 7 },
        { "qci": 9, "cbs": 2048,  "ebs": 2048,  "pbs": 2048,  "priority": 6 },
        { "qci": 8, "cbs": 2048,  "ebs": 2048,  "pbs": 2048,  "priority": 5 }
    ],

    "slice_rate_limit_config": {
        "n6_bps": 500000000,
        "n6_burst_bytes": 625000,
        "n3_bps": 500000000,
        "n3_burst_bytes": 625000
    },

    "cpiface": {
        "peers": [],
        "hostname": "upf",
        "dnn": "internet",
        "http_port": "8080",
        "enable_ue_ip_alloc": false,
        "ue_ip_pool": "10.250.0.0/16"
    }
}
